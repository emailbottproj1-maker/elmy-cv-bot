# ==== Gmail SMTP Settings ====
# الإيميل المستخدم للإرسال
GMAIL_ADDRESS=your-email@gmail.com
# App Password (16 chars) - NOT your normal password
# How to get it: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# الاسم الذي يظهر للمستقبِل
SENDER_NAME=Your Full Name

# ==== Email Content ====
# Subject ثابت (يدعم {company_name})
SUBJECT_AR=طلب توظيف - سيرة ذاتية
SUBJECT_EN=Job Application - CV

# ==== Sending Behavior ====
# الحد اليومي للإيميلات
DAILY_CAP=50
# الفاصل الزمني بين الإيميلات (بالثواني)
MIN_DELAY=60
MAX_DELAY=180

# ==== Tracking Pixel (Vercel) ====
# رابط خدمة البكسل بعد نشرها على Vercel
PIXEL_BASE_URL=https://elmy-pixel.vercel.app
# توكن سري لجلب الإحصائيات (نفس القيمة في Vercel env)
STATS_TOKEN=change-me-to-a-random-secret

# ==== File Paths (defaults, can be set from GUI) ====
CV_PATH=data/cv.pdf
COVER_LETTER_AR=data/cover_letter_ar.txt
COVER_LETTER_EN=data/cover_letter_en.txt
COMPANIES_XLSX=data/companies.xlsx
